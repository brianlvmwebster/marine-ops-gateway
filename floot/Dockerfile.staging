FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN VITE_APP_ENV=staging npm run build
FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/staging ./staging
COPY --from=build --chown=node:node /app/platform ./platform
COPY --from=build --chown=node:node /app/helpers ./helpers
COPY --from=build --chown=node:node /app/endpoints ./endpoints
COPY --from=build --chown=node:node /app/migrations ./migrations
COPY --from=build --chown=node:node /app/scheduler ./scheduler
USER node
EXPOSE 8080
CMD ["node","--import","tsx","staging/server.ts"]
