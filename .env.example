# Pull development settings with: npx vercel env pull .env.local --yes
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Exact additional origins, if needed. No wildcards.
AUTH_EXTRA_ORIGINS=
# Pre-production: set these only for the preproduction preview branch.
# Never use common/organizations/consumers as the tenant ID.
AUTH_MICROSOFT_ONLY=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
